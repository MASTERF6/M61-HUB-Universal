getgenv().RAYFIELD_SECURE = true
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local VirtualUser = game:GetService("VirtualUser")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local States = {
    Speed = false, SpeedValue = 50,
    Fly = false, FlyValue = 50,
    ESP = false, Noclip = false, Nofog = false,
    Fullbright = false, Day = false,
    AntiGameplayPaused = false, AntiIdle = false,
    InstantProximity = false, LineESP = false
}

local Connections = {}
local ESPObjects = {}
local SavedCFrame = nil
local SelectedPlayer = nil
local FlyConnection, FlyBV, FlyBG = nil, nil, nil
local LinePosition, LineAnchor, LineStart, LineBeam, LineAtt0, LineAtt1, LineBillboard

local function cleanup(name)
    if Connections[name] then
        Connections[name]:Disconnect()
        Connections[name] = nil
    end
end

-- SPEED
local function applySpeed()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = States.Speed and States.SpeedValue or 16 end
end

local function setupSpeed()
    cleanup("Speed")
    if States.Speed then
        applySpeed()
        Connections.Speed = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(0.3)
            applySpeed()
        end)
    else
        applySpeed()
    end
end

-- FLY
local function stopFly()
    if FlyConnection then FlyConnection:Disconnect() FlyConnection = nil end
    if FlyBV then FlyBV:Destroy() FlyBV = nil end
    if FlyBG then FlyBG:Destroy() FlyBG = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function startFly()
    stopFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    hum.PlatformStand = true
    FlyBV = Instance.new("BodyVelocity")
    FlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    FlyBV.Velocity = Vector3.zero
    FlyBV.Parent = hrp
    FlyBG = Instance.new("BodyGyro")
    FlyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    FlyBG.P = 9e4
    FlyBG.Parent = hrp

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not States.Fly then stopFly() return end
        if not hrp.Parent or not hum.Parent then stopFly() return end
        local speed = States.FlyValue
        local md = hum.MoveDirection
        local cam = workspace.CurrentCamera
        local horizontal = Vector3.new(md.X, 0, md.Z)
        if horizontal.Magnitude > 0 then horizontal = horizontal.Unit * speed end
        local up = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then up = speed
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then up = -speed end
        if UserInputService.TouchEnabled then
            local lookY = cam.CFrame.LookVector.Y
            if math.abs(lookY) > 0.4 and md.Magnitude > 0.1 then up = speed * lookY end
        end
        FlyBV.Velocity = Vector3.new(horizontal.X, up, horizontal.Z)
        FlyBG.CFrame = cam.CFrame
    end)
end

local function setupFly()
    if States.Fly then
        startFly()
        cleanup("FlyRespawn")
        Connections.FlyRespawn = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(0.6)
            if States.Fly then startFly() end
        end)
    else
        stopFly()
        cleanup("FlyRespawn")
    end
end

-- ESP
local function getESPColor(player)
    if player.Team then
        local t = string.lower(player.Team.Name)
        if t:find("seek") or t:find("hunter") or t:find("murder") then return Color3.fromRGB(255, 50, 50) end
        if t:find("hide") or t:find("innocent") or t:find("survivor") then return Color3.fromRGB(50, 150, 255) end
        if t:find("lobby") or t:find("wait") then return Color3.fromRGB(180, 180, 180) end
        if player.TeamColor then return player.TeamColor.Color end
    end
    return Color3.fromRGB(0, 255, 128)
end

local function createESP(player)
    if player == LocalPlayer or ESPObjects[player] then return end
    local function setupCharacter(char)
        if not char then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end
        if ESPObjects[player] then
            pcall(function()
                if ESPObjects[player].Highlight then ESPObjects[player].Highlight:Destroy() end
                if ESPObjects[player].Billboard then ESPObjects[player].Billboard:Destroy() end
            end)
        end
        local color = getESPColor(player)
        local highlight = Instance.new("Highlight")
        highlight.FillColor = color
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.55
        highlight.Adornee = char
        highlight.Parent = char
        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = hrp
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = char
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = color
        nameLabel.TextStrokeTransparency = 0.3
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 14
        nameLabel.Parent = billboard
        local distLabel = Instance.new("TextLabel")
        distLabel.Size = UDim2.new(1, 0, 0.5, 0)
        distLabel.Position = UDim2.new(0, 0, 0.5, 0)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = "0 studs"
        distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        distLabel.TextStrokeTransparency = 0.3
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextSize = 12
        distLabel.Parent = billboard
        ESPObjects[player] = { Highlight = highlight, Billboard = billboard, NameLabel = nameLabel, DistLabel = distLabel }
    end
    if player.Character then setupCharacter(player.Character) end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.4)
        if States.ESP then setupCharacter(char) end
    end)
end

local function removeESP(player)
    if ESPObjects[player] then
        pcall(function()
            if ESPObjects[player].Highlight then ESPObjects[player].Highlight:Destroy() end
            if ESPObjects[player].Billboard then ESPObjects[player].Billboard:Destroy() end
        end)
        ESPObjects[player] = nil
    end
end

local function updateESP()
    if not States.ESP then return end
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for player, data in pairs(ESPObjects) do
        if player.Parent and data.DistLabel then
            local c = getESPColor(player)
            if data.Highlight then data.Highlight.FillColor = c end
            if data.NameLabel then data.NameLabel.TextColor3 = c data.NameLabel.Text = player.Name end
            if myHRP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                data.DistLabel.Text = math.floor((myHRP.Position - player.Character.HumanoidRootPart.Position).Magnitude) .. " studs"
            end
        end
    end
end

local function setupESP()
    cleanup("ESPJoin") cleanup("ESPUpdate")
    if States.ESP then
        for _, plr in ipairs(Players:GetPlayers()) do createESP(plr) end
        Connections.ESPJoin = Players.PlayerAdded:Connect(createESP)
        Players.PlayerRemoving:Connect(removeESP)
        Connections.ESPUpdate = RunService.RenderStepped:Connect(updateESP)
    else
        for plr in pairs(ESPObjects) do removeESP(plr) end
    end
end

-- LINE ESP
local function destroyLineESP()
    cleanup("LineESP")
    for _, v in pairs({LineBeam, LineAtt0, LineAtt1, LineBillboard, LineAnchor, LineStart}) do
        if v then pcall(function() v:Destroy() end) end
    end
    LineBeam, LineAtt0, LineAtt1, LineBillboard, LineAnchor, LineStart = nil, nil, nil, nil, nil, nil
end

local function createLineESP()
    destroyLineESP()
    if not LinePosition then return end
    local cam = workspace.CurrentCamera
    LineStart = Instance.new("Part")
    LineStart.Anchored = true
    LineStart.CanCollide = false
    LineStart.Transparency = 1
    LineStart.Size = Vector3.new(0.2, 0.2, 0.2)
    LineStart.CFrame = cam.CFrame * CFrame.new(0, -0.5, -3)
    LineStart.Parent = workspace
    LineAnchor = Instance.new("Part")
    LineAnchor.Anchored = true
    LineAnchor.CanCollide = false
    LineAnchor.Transparency = 1
    LineAnchor.Size = Vector3.new(1, 1, 1)
    LineAnchor.Position = LinePosition
    LineAnchor.Parent = workspace
    LineBillboard = Instance.new("BillboardGui")
    LineBillboard.Size = UDim2.new(0, 120, 0, 40)
    LineBillboard.AlwaysOnTop = true
    LineBillboard.StudsOffset = Vector3.new(0, 2, 0)
    LineBillboard.Adornee = LineAnchor
    LineBillboard.Parent = LineAnchor
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "Target"
    label.TextColor3 = Color3.fromRGB(0, 255, 255)
    label.TextStrokeTransparency = 0.2
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = LineBillboard
    LineAtt0 = Instance.new("Attachment", LineStart)
    LineAtt1 = Instance.new("Attachment", LineAnchor)
    LineBeam = Instance.new("Beam")
    LineBeam.Attachment0 = LineAtt0
    LineBeam.Attachment1 = LineAtt1
    LineBeam.FaceCamera = true
    LineBeam.Width0 = 0.4
    LineBeam.Width1 = 0.15
    LineBeam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255))
    LineBeam.Transparency = NumberSequence.new(0.15)
    LineBeam.LightEmission = 1
    LineBeam.Parent = LineStart
    Connections.LineESP = RunService.RenderStepped:Connect(function()
        if not States.LineESP or not LinePosition then destroyLineESP() return end
        local camera = workspace.CurrentCamera
        if LineStart and camera then LineStart.CFrame = camera.CFrame * CFrame.new(0, -0.5, -3) end
        if LineAnchor then LineAnchor.Position = LinePosition end
        if label and camera then
            label.Text = math.floor((camera.CFrame.Position - LinePosition).Magnitude) .. " studs"
        end
    end)
end

local function setupLineESP()
    if States.LineESP and LinePosition then createLineESP() else destroyLineESP() end
end

local function setLinePosition()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        LinePosition = char.HumanoidRootPart.Position
        Rayfield:Notify({ Title = "M61 Hub", Content = "Line position set!", Duration = 3 })
        if States.LineESP then createLineESP() end
    end
end

-- LAINNYA
local function setupNoclip()
    cleanup("Noclip")
    if States.Noclip then
        Connections.Noclip = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)
    end
end

local function setupNofog()
    Lighting.FogEnd = States.Nofog and 100000 or 1000
    if States.Nofog then Lighting.FogStart = 0 end
end

local oldB, oldC, oldA
local function setupFullbright()
    if States.Fullbright then
        oldB, oldC, oldA = Lighting.Brightness, Lighting.ClockTime, Lighting.Ambient
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    else
        if oldB then Lighting.Brightness = oldB end
        if oldC then Lighting.ClockTime = oldC end
        if oldA then Lighting.Ambient = oldA end
    end
end

local function setupDay()
    cleanup("Day")
    if States.Day then
        Lighting.ClockTime = 14
        Connections.Day = RunService.Heartbeat:Connect(function()
            if States.Day then Lighting.ClockTime = 14 end
        end)
    end
end

local function setupAntiGameplayPaused()
    cleanup("AntiGameplayPaused")
    if States.AntiGameplayPaused then
        Connections.AntiGameplayPaused = LocalPlayer:GetPropertyChangedSignal("GameplayPaused"):Connect(function()
            if LocalPlayer.GameplayPaused then LocalPlayer.GameplayPaused = false end
        end)
    end
end

local function setupAntiIdle()
    cleanup("AntiIdle")
    if States.AntiIdle then
        Connections.AntiIdle = LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
end

local function setupInstantProximity()
    cleanup("InstantProximityAdded")
    if States.InstantProximity then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end
        end
        Connections.InstantProximityAdded = workspace.DescendantAdded:Connect(function(v)
            if v:IsA("ProximityPrompt") then task.defer(function() v.HoldDuration = 0 end) end
        end)
    end
end

local function savePosition()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        SavedCFrame = char.HumanoidRootPart.CFrame
        Rayfield:Notify({ Title = "M61 Hub", Content = "Position saved!", Duration = 3 })
    end
end

local function teleportToSaved()
    if not SavedCFrame then
        Rayfield:Notify({ Title = "M61 Hub", Content = "Belum ada posisi!", Duration = 3 })
        return
    end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = SavedCFrame
    end
end

local function getPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(list, plr.Name) end
    end
    table.sort(list)
    return list
end

local function teleportToPlayer(name)
    if not name then return end
    local target = Players:FindFirstChild(name)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
        end
    end
end

