-- ===================== SPEED =====================
local function applySpeed()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = States.Speed and States.SpeedValue or 16
    end
end

local function setupSpeed()
    cleanup("Speed")
    if States.Speed then
        applySpeed()
        Connections.Speed = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(0.3)
            applySpeed()
        end)
    else
        applySpeed()
    end
end

-- ===================== FLY (IY Style) =====================
local function stopFly()
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end
    if FlyBV then FlyBV:Destroy() FlyBV = nil end
    if FlyBG then FlyBG:Destroy() FlyBG = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function startFly()
    stopFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    hum.PlatformStand = true

    FlyBV = Instance.new("BodyVelocity")
    FlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    FlyBV.Velocity = Vector3.zero
    FlyBV.Parent = hrp

    FlyBG = Instance.new("BodyGyro")
    FlyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    FlyBG.P = 9e4
    FlyBG.Parent = hrp

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not States.Fly then stopFly() return end
        if not hrp or not hrp.Parent or not hum or not hum.Parent then stopFly() return end

        local speed = States.FlyValue
        local md = hum.MoveDirection
        local cam = workspace.CurrentCamera

        local horizontal = Vector3.new(md.X, 0, md.Z)
        if horizontal.Magnitude > 0 then
            horizontal = horizontal.Unit * speed
        end

        local up = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then
            up = speed
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then
            up = -speed
        end

        if UserInputService.TouchEnabled then
            local lookY = cam.CFrame.LookVector.Y
            if math.abs(lookY) > 0.4 and md.Magnitude > 0.1 then
                up = speed * lookY
            end
        end

        FlyBV.Velocity = Vector3.new(horizontal.X, up, horizontal.Z)
        FlyBG.CFrame = cam.CFrame
    end)
end

local function setupFly()
    if States.Fly then
        startFly()
        cleanup("FlyRespawn")
        Connections.FlyRespawn = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(0.6)
            if States.Fly then startFly() end
        end)
    else
        stopFly()
        cleanup("FlyRespawn")
    end
end

-- ===================== ESP =====================
local function getESPColor(player)
    if player.Team then
        local teamName = string.lower(player.Team.Name)
        if string.find(teamName, "seek") or string.find(teamName, "hunter") or string.find(teamName, "murder") then
            return Color3.fromRGB(255, 50, 50)
        elseif string.find(teamName, "hide") or string.find(teamName, "innocent") or string.find(teamName, "survivor") then
            return Color3.fromRGB(50, 150, 255)
        elseif string.find(teamName, "lobby") or string.find(teamName, "wait") then
            return Color3.fromRGB(180, 180, 180)
        end
        if player.TeamColor then return player.TeamColor.Color end
    end

    local role = player:GetAttribute("Role") or player:GetAttribute("role") or player:GetAttribute("Status")
    if typeof(role) == "string" then
        local r = string.lower(role)
        if string.find(r, "seek") or string.find(r, "hunter") or string.find(r, "murder") then
            return Color3.fromRGB(255, 50, 50)
        elseif string.find(r, "hide") or string.find(r, "innocent") then
            return Color3.fromRGB(50, 150, 255)
        end
    end

    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v:IsA("StringValue") or v:IsA("IntValue") then
                local val = string.lower(tostring(v.Value))
                if string.find(val, "seek") or string.find(val, "hunter") then
                    return Color3.fromRGB(255, 50, 50)
                elseif string.find(val, "hide") then
                    return Color3.fromRGB(50, 150, 255)
                end
            end
        end
    end

    return Color3.fromRGB(0, 255, 128)
end

local function createESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end

    local function setupCharacter(char)
        if not char then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end

        if ESPObjects[player] then
            pcall(function()
                if ESPObjects[player].Highlight then ESPObjects[player].Highlight:Destroy() end
                if ESPObjects[player].Billboard then ESPObjects[player].Billboard:Destroy() end
            end)
        end

        local color = getESPColor(player)

        local highlight = Instance.new("Highlight")
        highlight.FillColor = color
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.55
        highlight.OutlineTransparency = 0
        highlight.Adornee = char
        highlight.Parent = char

        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = hrp
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = char

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = color
        nameLabel.TextStrokeTransparency = 0.3
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 14
        nameLabel.Parent = billboard

        local distLabel = Instance.new("TextLabel")
        distLabel.Size = UDim2.new(1, 0, 0.5, 0)
        distLabel.Position = UDim2.new(0, 0, 0.5, 0)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = "0 studs"
        distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        distLabel.TextStrokeTransparency = 0.3
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextSize = 12
        distLabel.Parent = billboard

        ESPObjects[player] = {
            Highlight = highlight,
            Billboard = billboard,
            NameLabel = nameLabel,
            DistLabel = distLabel
        }
    end

    if player.Character then setupCharacter(player.Character) end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.4)
        if States.ESP then setupCharacter(char) end
    end)
end

local function removeESP(player)
    if ESPObjects[player] then
        pcall(function()
            if ESPObjects[player].Highlight then ESPObjects[player].Highlight:Destroy() end
            if ESPObjects[player].Billboard then ESPObjects[player].Billboard:Destroy() end
        end)
        ESPObjects[player] = nil
    end
end

local function updateESP()
    if not States.ESP then return end
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for player, data in pairs(ESPObjects) do
        if player.Parent and data.DistLabel and data.Highlight then
            local newColor = getESPColor(player)
            data.Highlight.FillColor = newColor
            if data.NameLabel then
                data.NameLabel.TextColor3 = newColor
                data.NameLabel.Text = player.Name
            end
            if myHRP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (myHRP.Position - player.Character.HumanoidRootPart.Position).Magnitude
                data.DistLabel.Text = string.format("%d studs", math.floor(dist))
            else
                data.DistLabel.Text = "?"
            end
        end
    end
end

local function setupESP()
    cleanup("ESPJoin")
    cleanup("ESPUpdate")
    if States.ESP then
        for _, plr in ipairs(Players:GetPlayers()) do createESP(plr) end
        Connections.ESPJoin = Players.PlayerAdded:Connect(createESP)
        Players.PlayerRemoving:Connect(removeESP)
        Connections.ESPUpdate = RunService.RenderStepped:Connect(updateESP)
    else
        for plr, _ in pairs(ESPObjects) do removeESP(plr) end
    end
end

-- ===================== LINE ESP (First Person Compatible) =====================
local function destroyLineESP()
    cleanup("LineESP")
    if LineBeam then LineBeam:Destroy() LineBeam = nil end
    if LineAtt0 then LineAtt0:Destroy() LineAtt0 = nil end
    if LineAtt1 then LineAtt1:Destroy() LineAtt1 = nil end
    if LineBillboard then LineBillboard:Destroy() LineBillboard = nil end
    if LineAnchor then LineAnchor:Destroy() LineAnchor = nil end
    if LineStart then LineStart:Destroy() LineStart = nil end
end

local function createLineESP()
    destroyLineESP()
    if not LinePosition then return end

    local cam = workspace.CurrentCamera

    LineStart = Instance.new("Part")
    LineStart.Name = "M61LineStart"
    LineStart.Anchored = true
    LineStart.CanCollide = false
    LineStart.CanQuery = false
    LineStart.Transparency = 1
    LineStart.Size = Vector3.new(0.2, 0.2, 0.2)
    LineStart.CFrame = cam.CFrame * CFrame.new(0, -0.5, -3)
    LineStart.Parent = workspace

    LineAnchor = Instance.new("Part")
    LineAnchor.Name = "M61LineEnd"
    LineAnchor.Anchored = true
    LineAnchor.CanCollide = false
    LineAnchor.CanQuery = false
    LineAnchor.Transparency = 1
    LineAnchor.Size = Vector3.new(1, 1, 1)
    LineAnchor.Position = LinePosition
    LineAnchor.Parent = workspace

    LineBillboard = Instance.new("BillboardGui")
    LineBillboard.Size = UDim2.new(0, 120, 0, 40)
    LineBillboard.AlwaysOnTop = true
    LineBillboard.StudsOffset = Vector3.new(0, 2, 0)
    LineBillboard.Adornee = LineAnchor
    LineBillboard.Parent = LineAnchor

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "📍 Target"
    label.TextColor3 = Color3.fromRGB(0, 255, 255)
    label.TextStrokeTransparency = 0.2
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = LineBillboard

    LineAtt0 = Instance.new("Attachment")
    LineAtt0.Parent = LineStart

    LineAtt1 = Instance.new("Attachment")
    LineAtt1.Parent = LineAnchor

    LineBeam = Instance.new("Beam")
    LineBeam.Attachment0 = LineAtt0
    LineBeam.Attachment1 = LineAtt1
    LineBeam.FaceCamera = true
    LineBeam.Width0 = 0.4
    LineBeam.Width1 = 0.15
    LineBeam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255))
    LineBeam.Transparency = NumberSequence.new(0.15)
    LineBeam.LightEmission = 1
    LineBeam.Segments = 20
    LineBeam.Parent = LineStart

    Connections.LineESP = RunService.RenderStepped:Connect(function()
        if not States.LineESP or not LinePosition then
            destroyLineESP()
            return
        end

        local camera = workspace.CurrentCamera
        if LineStart and camera then
            LineStart.CFrame = camera.CFrame * CFrame.new(0, -0.5, -3)
        end

        if LineAnchor then
            LineAnchor.Position = LinePosition
        end

        if label and camera then
            local dist = (camera.CFrame.Position - LinePosition).Magnitude
            label.Text = string.format("📍 %d studs", math.floor(dist))
        end
    end)
end

local function setupLineESP()
    if States.LineESP and LinePosition then
        createLineESP()
    else
        destroyLineESP()
    end
end

local function setLinePosition()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        LinePosition = char.HumanoidRootPart.Position
        pcall(function()
            Rayfield:Notify({Title = "M61 Hub", Content = "Line position set!", Duration = 3})
        end)
        if States.LineESP then
            createLineESP()
        end
    end
end

-- ===================== NOCLIP =====================
local function setupNoclip()
    cleanup("Noclip")
    if States.Noclip then
        Connections.Noclip = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

-- ===================== NOFOG =====================
local function setupNofog()
    if States.Nofog then
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
    else
        Lighting.FogEnd = 1000
    end
end

-- ===================== FULLBRIGHT =====================
local oldBrightness, oldClockTime, oldAmbient

local function setupFullbright()
    if States.Fullbright then
        oldBrightness = Lighting.Brightness
        oldClockTime = Lighting.ClockTime
        oldAmbient = Lighting.Ambient
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    else
        if oldBrightness then Lighting.Brightness = oldBrightness end
        if oldClockTime then Lighting.ClockTime = oldClockTime end
        if oldAmbient then Lighting.Ambient = oldAmbient end
    end
end

